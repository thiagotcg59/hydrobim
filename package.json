{
  "name": "hydrobim",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma BIM hidráulica 3D para MEP, redes de abastecimento e adutoras com interoperabilidade IFC",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @hydrobim/web",
    "build": "npm run build --workspace @hydrobim/web",
    "preview": "npm run preview --workspace @hydrobim/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --ignore-unknown --write \"apps/**\" \"packages/**\" \"tests/**\" \".github/**\" \"*.{ts,js,json}\"",
    "format:check": "prettier --ignore-unknown --check \"apps/**\" \"packages/**\" \"tests/**\" \".github/**\" \"*.{ts,js,json}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "examples:generate": "vitest run --config vitest.examples.config.ts",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
